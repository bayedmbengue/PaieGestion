{
  "name": "paiegestion-desktop",
  "productName": "PaieGestion",
  "version": "1.0.0",
  "description": "PaieGestion — Gestion de la paie (Sénégal), application de bureau avec SQL Server",
  "main": "main.js",
  "author": "PaieGestion",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node scripts/run-electron.js",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win nsis --x64",
    "web": "node server.js"
  },
  "dependencies": {
    "mssql": "^12.2.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "sn.paiegestion.desktop",
    "productName": "PaieGestion",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "sql/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1036"
    }
  }
}
